#!/bin/sh
# Bloquea commits directos en ramas protegidas (main/master)
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "❌ BLOCKED: no puedes commitear directo en '$branch'."
  echo "   Crea una rama: git checkout -b feature/..."
  exit 1
fi

